# ============================================================
# ShopKart Backend — Environment template
# ============================================================
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopkart
DB_USER=shopkart_user
DB_PASSWORD=change_me_postgres_password
DB_POOL_MAX=10

# ---------- JWT ----------
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---------- CORS (comma-separated) ----------
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://localhost
