# ============================================================
# ShopKart — Root environment template
# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shopkart
POSTGRES_USER=shopkart_user
POSTGRES_PASSWORD=change_me_postgres_password

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=5000
BACKEND_HOST=0.0.0.0

# JWT — must be a long random string (>= 32 chars)
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://localhost

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
# Used at BUILD time by Vite (baked into the JS bundle)
VITE_API_BASE_URL=/api

# Used at RUNTIME by nginx inside the frontend container
VITE_API_PROXY_TARGET=http://backend:5000

# ------------------------------------------------------------
# Docker Hub (used by Jenkinsfile — prefer Jenkins Credentials)
# ------------------------------------------------------------
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token

# ------------------------------------------------------------
# Image names / tags (referenced by Compose, Jenkins, Helm)
# ------------------------------------------------------------
FRONTEND_IMAGE=shopkart-frontend
BACKEND_IMAGE=shopkart-backend
IMAGE_TAG=latest

# ------------------------------------------------------------
# AWS (only needed from Phase 11 onward)
# ------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
EKS_CLUSTER_NAME=shopkart-eks

