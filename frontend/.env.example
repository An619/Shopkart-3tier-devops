# ============================================================
# Frontend environment variables
# ============================================================
# Anything prefixed with VITE_ is exposed to the browser bundle.
# DO NOT put secrets here.
# ============================================================

# Base path used by the app for API calls.
# In all environments we use /api because nginx proxies it.
VITE_API_BASE_URL=/api

# Local dev only: where Vite should forward /api during `npm run dev`.
# Ignored in Docker / K8s (nginx proxy handles it there).
VITE_API_PROXY_TARGET=http://localhost:5000

